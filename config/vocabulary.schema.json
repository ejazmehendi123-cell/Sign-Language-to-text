{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISL Kiosk Vocabulary Schema",
  "type": "object",
  "required": ["version", "vocabulary"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gloss",
          "labels",
          "category",
          "verified",
          "verified_by",
          "source_ref",
          "regional_variant",
          "two_handed",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "gloss": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "required": ["en", "hi", "mr"],
            "properties": {
              "en": { "type": "string" },
              "hi": { "type": "string" },
              "mr": { "type": "string" }
            },
            "additionalProperties": { "type": "string" }
          },
          "category": {
            "type": "string",
            "enum": [
              "pronoun",
              "action",
              "document",
              "service",
              "query",
              "confirmation",
              "status",
              "politeness",
              "system",
              "number"
            ]
          },
          "verified": { "type": "boolean" },
          "verified_by": { "type": ["string", "null"] },
          "source_ref": { "type": ["string", "null"] },
          "regional_variant": { "type": ["string", "null"] },
          "two_handed": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
